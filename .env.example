# GoHighLevel Private Integration Token
# Get this from GHL: Settings > Business Profile > API Keys / Private Integrations
GHL_API_KEY=your_ghl_private_integration_token_here

# GoHighLevel Location ID (found in Settings > Business Profile)
GHL_LOCATION_ID=your_ghl_location_id_here

# GHL API base URL (v2). Leave as-is unless GHL changes their API.
GHL_API_BASE=https://services.leadconnectorhq.com

# Server port
PORT=3000

# How often agents run automatically, in cron syntax. Default = every hour on the hour.
AGENT_CRON_SCHEDULE=0 * * * *

# Business config used by agent logic
MONTHLY_LSA_BUDGET=200
MONTHLY_LEAD_VOLUME_TARGET=200
